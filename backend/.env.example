# CourtCRM Pro — Environment Configuration
# Copy to .env and adjust values

DATABASE_URL=postgresql+asyncpg://courtcrm:courtcrm@localhost:5432/courtcrm
DATABASE_SYNC_URL=postgresql+psycopg2://courtcrm:courtcrm@localhost:5432/courtcrm
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Parser
AI_MODEL_PATH=
CLAUDE_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.65

# Export encryption
EXPORT_ENCRYPTION_KEY=

# Backup
BACKUP_DIR=/var/backups/courtcrm
